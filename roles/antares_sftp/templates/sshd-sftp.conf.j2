{{ ansible_managed | comment }}
#
# The study upload accounts, and only them: each one is locked in
# {{ antares_sftp_chroot }}, where /{{ antares_sftp_dir }} is the upload
# directory of the `{{ antares_sftp_workspace }}` workspace, and gets SFTP and
# nothing else. A Match block in an included file ends with that file, so
# nothing that follows the Include line in sshd_config falls into it.
#
#   sshd -T -C user=<account>,host=x,addr=127.0.0.1 | grep -E 'chroot|forcecommand|authorizedkeysfile'

Match Group {{ antares_sftp_group }}
    ChrootDirectory {{ antares_sftp_chroot }}
    # -d starts the session in the upload directory. -u 0002 keeps the
    # group bits the client asks for: directories come out 0775, files with
    # the mode of the client's copy, 0644 as a rule. The directory being
    # setgid, all of it belongs to the group the containers run as, which can
    # read, scan and copy every file and delete in every directory. No -m:
    # forcing the mode of files is a Red Hat patch, and an internal-sftp
    # without it refuses the option and closes every session.
    ForceCommand internal-sftp -d /{{ antares_sftp_dir }} -u 0002
    AuthorizedKeysFile {{ antares_sftp_keys_dir }}/%u
    AuthenticationMethods publickey
    PermitTTY no
    DisableForwarding yes
    PermitTunnel no
