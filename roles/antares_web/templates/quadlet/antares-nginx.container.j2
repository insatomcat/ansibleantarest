{{ ansible_managed | comment }}
#
# Serves the built web application from /www and proxies /api/ to the backend.
#
# Named antares-nginx rather than upstream's `nginx`: nothing resolves it by
# name, and a generic `nginx` container name collides with anything else the
# machine may already run. It keeps the default root user, since it binds port
# 80 inside the container.

[Unit]
Description=Antares-Web nginx
# Requires=, not Wants=: without the backend running there is no `antarest`
# name on the podman network, and nginx refuses to start at all rather than
# serving the front end alone (`host not found in upstream "antarest"`, the
# upstream name being resolved once, when the configuration is parsed).
# antarest.service carries the Upholds= that brings this unit back up once the
# backend recovers.
Requires=antarest.service
After=antarest.service
PartOf={{ antarest_service_name }}.target
# No start budget, unlike every other unit of the stack, and this one is the
# exception on purpose. The ordinary failure of this container is not a broken
# nginx, it is a backend that is not there yet, which it cannot start without
# (see Requires= above); retrying until the backend is back is the recovery,
# not a loop to cut short. A budget here turns a backend outage of a few
# minutes into a front end that stays down: the attempts are spent while the
# backend crash-loops, the unit lands in `failed`, and from there even the
# Upholds= of the backend is turned away with `Start request repeated too
# quickly`. The price is that a genuinely broken nginx retries every
# RestartSec instead of stopping; its journal gives the reason each time.
StartLimitIntervalSec=0

[Container]
ContainerName={{ antarest_nginx_container }}
Image={{ antarest_nginx_image }}
Network={{ antarest_service_name }}.network
PublishPort={{ antarest_http_port }}:80
{% if antarest_tls_active | bool %}
PublishPort={{ antarest_https_port }}:443
{% endif %}
{% for volume in antarest_nginx_volumes %}
Volume={{ volume }}
{% endfor %}
# The access log is what the fail2ban jail watching the login endpoint reads,
# through journalctl CONTAINER_NAME={{ antarest_nginx_container }}. journald is
# already podman's default here, but the jail stops seeing anything at all if
# that default ever moves, so it is pinned rather than assumed.
LogDriver=journald

[Service]
# on-failure, and with no budget in [Unit] to stop it: the front end retries
# every RestartSec for as long as it takes the backend to come back. What this
# does not cover is being stopped rather than failed, which is what the
# Requires= does when the backend goes down; the Upholds= of antarest.service
# is the other half of that.
Restart=on-failure
RestartSec=10

[Install]
WantedBy={{ antarest_service_name }}.target
