{{ ansible_managed | comment }}
#
# The API backend. ContainerName must stay `antarest`: the nginx configuration
# shipped by the project proxies to http://antarest:5000/.
#
# UVICORN_ROOT_PATH mirrors the `root_path: api` of config.prod.yaml, which is
# what makes the API work behind the nginx /api/ prefix.

[Unit]
Description=Antares-Web backend
Requires=postgresql.service redis.service
After=postgresql.service redis.service
PartOf={{ antarest_service_name }}.target
# Start budget for the Restart= below: five attempts, then the unit gives up.
# This is the one that needs them: After=postgresql.service only means the
# postgres *container* started, not that it accepts connections yet.
StartLimitIntervalSec=300
StartLimitBurst=5
# The other direction of the dependency antares-nginx declares on this unit.
# That one only propagates downwards: when this backend exhausts the budget
# above, the start job of antares-nginx fails with 'dependency', and nothing
# starts it again once the backend recovers, so the interface stays down long
# after its cause is gone. Upholds= closes that: while this unit is active,
# systemd starts antares-nginx whenever it finds it inactive or failed.
#
# It is deliberately here rather than on the target, and it names nginx alone:
# a backend container that keeps dying must stay `failed` rather than loop out
# of sight, which is the whole point of the start budget. The price is that
# `systemctl stop antares-nginx` no longer holds while the backend runs; stop
# the target, or the backend, to take the front end down.
Upholds=antares-nginx.service
{% if antarest_data_device %}
# The state is on a volume mounted with nofail. Without this the unit would
# start on the empty mount point of the boot disk instead of failing visibly.
RequiresMountsFor={{ antarest_data_dir }}
{% endif %}

[Container]
ContainerName=antarest
Image={{ antarest_image }}
Network={{ antarest_service_name }}.network
User={{ antares_uid }}:{{ antares_gid }}
Environment=UVICORN_ROOT_PATH=/api
Environment=GUNICORN_WORKERS={{ antarest_gunicorn_workers }}
# The backend only learns the scheme of the original request from the
# X-Forwarded-Proto that travels from the front door through antares-nginx, and
# gunicorn ignores that header unless the proxy address is trusted. Nothing but
# nginx can reach port 5000, which is published nowhere and lives on the podman
# network, so the wildcard trusts exactly one client.
Environment=FORWARDED_ALLOW_IPS={{ antarest_forwarded_allow_ips }}
{% for volume in antarest_backend_volumes %}
Volume={{ volume }}
{% endfor %}

[Service]
# The first start migrates the database schema, which is not instant.
TimeoutStartSec=300
# on-failure, not always: a container that keeps dying exhausts the budget in
# [Unit] and stays `failed` instead of looping out of sight. See the README.
Restart=on-failure
RestartSec=10

[Install]
WantedBy={{ antarest_service_name }}.target
