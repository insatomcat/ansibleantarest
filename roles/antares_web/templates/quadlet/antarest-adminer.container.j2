{{ ansible_managed | comment }}
#
# Optional database web UI, off by default (antarest_enable_adminer).
# Published on 127.0.0.1 only: it exposes the whole database and carries no
# authentication of its own beyond the postgres credentials.
# Reach it through an SSH tunnel:
#   ssh -L 8080:127.0.0.1:8080 {{ inventory_hostname }}

[Unit]
Description=Antares-Web adminer
Requires=postgresql.service
After=postgresql.service
PartOf={{ antarest_service_name }}.target
# Start budget for the Restart= below: five attempts, then the unit gives up.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
ContainerName=antarest-adminer
Image={{ antarest_adminer_image }}
Network={{ antarest_service_name }}.network
PublishPort=127.0.0.1:8080:8080
Exec=php -S 0.0.0.0:8080 -t /var/www/html

[Service]
# on-failure, not always: a container that keeps dying exhausts the budget in
# [Unit] and stays `failed` instead of looping out of sight. See the README.
Restart=on-failure
RestartSec=10

[Install]
WantedBy={{ antarest_service_name }}.target
