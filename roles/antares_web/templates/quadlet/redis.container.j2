{{ ansible_managed | comment }}
#
# No volume: redis is only used to coordinate the gunicorn workers, so its
# contents are disposable. config.prod.yaml points at host `redis`, which is
# this container name.

[Unit]
Description=Antares-Web Redis
PartOf={{ antarest_service_name }}.target

[Container]
ContainerName=redis
Image={{ antarest_redis_image }}
Network={{ antarest_service_name }}.network

[Install]
WantedBy={{ antarest_service_name }}.target
