{{ ansible_managed | comment }}
#
# No volume: redis is only used to coordinate the gunicorn workers, so its
# contents are disposable. config.prod.yaml points at host `redis`, which is
# this container name.

[Unit]
Description=Antares-Web Redis
PartOf={{ antarest_service_name }}.target
# Start budget for the Restart= below: five attempts, then the unit gives up.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
ContainerName=redis
Image={{ antarest_redis_image }}
Network={{ antarest_service_name }}.network

[Service]
# on-failure, not always: a container that keeps dying exhausts the budget in
# [Unit] and stays `failed` instead of looping out of sight. See the README.
Restart=on-failure
RestartSec=10

[Install]
WantedBy={{ antarest_service_name }}.target
