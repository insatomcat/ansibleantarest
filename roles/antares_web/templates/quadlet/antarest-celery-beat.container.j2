{{ ansible_managed | comment }}
#
# The scheduler. It pushes the periodic maintenance tasks on the `maintenance`
# queue that antarest-celery-worker consumes, and does nothing else: it needs
# the configuration file to read the intervals, and redis to reach the broker.
#
# Exactly one beat may run against a deployment. A second one does not share
# the work, it schedules every task a second time.

[Unit]
Description=Antares-Web maintenance scheduler (celery beat)
Requires=redis.service
After=redis.service
PartOf={{ antarest_service_name }}.target
# Start budget for the Restart= below: five attempts, then the unit gives up.
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
ContainerName=antarest-celery-beat
Image={{ antarest_image }}
Network={{ antarest_service_name }}.network
User={{ antares_uid }}:{{ antares_gid }}
Volume={{ antarest_deploy_dir }}/config.prod.yaml:/resources/application.yaml:ro{{ container_volume_opts | trim }}
# The beat reads the configuration and nothing else, but reading it is enough
# to need this one: since 2.34 the loader creates the out-of-study output
# directory as it parses, so a beat without the mount dies on start.
Volume={{ antarest_data_dir }}/outputs:/outputs:rw{{ container_volume_opts | trim }}
Volume={{ antarest_data_dir }}/celerybeat:{{ antarest_celerybeat_dir }}:rw{{ container_volume_opts | trim }}
# Two podman flags instead of a plain Exec=, for one reason: celery beat keeps
# the last run time of every task in a shelve file whose default name,
# `celerybeat-schedule`, is *relative* to the working directory. The image
# declares no WORKDIR, so that is `/`, which the container cannot write to since
# it runs as {{ antares_uid }} rather than root. --workdir moves it onto the bind mount
# above, where it also survives a restart, and --entrypoint then becomes
# mandatory: the image entrypoint is itself the relative path
# ./scripts/start.sh, which no longer resolves once the working directory has
# moved.
#
# Both go through PodmanArgs= rather than the WorkingDir= and Entrypoint=
# quadlet keys, which only exist from podman 5.0: Ubuntu 24.04 ships 4.9.
PodmanArgs=--workdir={{ antarest_celerybeat_dir }} --entrypoint=/scripts/start.sh
Exec=celery-beat

[Service]
# on-failure, not always: a container that keeps dying exhausts the budget in
# [Unit] and stays `failed` instead of looping out of sight. See the README.
Restart=on-failure
RestartSec=10

[Install]
WantedBy={{ antarest_service_name }}.target
