{{ ansible_managed | comment }}
#
# Garbage-collects orphaned matrices. `matrix_gc_dry_run: true` in
# config.prod.yaml means it only reports what it would delete.

[Unit]
Description=Antares-Web matrix garbage collector
Requires=antarest.service
After=antarest.service
PartOf={{ antarest_service_name }}.target

[Container]
ContainerName=antarest-matrix-gc
Image={{ antarest_image }}
Network={{ antarest_service_name }}.network
User={{ antares_uid }}:{{ antares_gid }}
{% for volume in antarest_shared_volumes %}
Volume={{ volume }}
{% endfor %}
Exec=matrix_gc

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy={{ antarest_service_name }}.target
