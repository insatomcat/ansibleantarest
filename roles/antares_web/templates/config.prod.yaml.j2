{{ ansible_managed | comment }}
# Mounted as /resources/application.yaml inside the antarest containers.

security:
  disabled: false
  jwt:
    key: "{{ antarest_jwt_key }}"
  login:
    admin:
      pwd: "{{ antarest_admin_password }}"
  external_auth:
    url: "{{ antarest_external_auth_url }}"
    default_group_role: {{ antarest_external_auth_default_group_role }}
    add_ext_groups: {{ antarest_external_auth_add_ext_groups | bool | lower }}
    group_mapping: {{ antarest_external_auth_group_mapping | to_json }}

db:
  url: "postgresql://postgres:{{ antarest_db_password }}@postgresql:5432/postgres"
  admin_url: "postgresql://postgres:{{ antarest_db_password }}@postgresql:5432/postgres"
  pool_recycle: 3600

storage:
  tmp_dir: /antarest_tmp_dir
  archive_dir: /studies/archives
  matrixstore: /matrixstore
  # Must be set: the default in antarest/core/config.py is the *relative* path
  # ./blobstore, so the application tries to create it in its working directory
  # (/ inside the container) and dies with
  # `PermissionError: [Errno 13] Permission denied: 'blobstore'`, since the
  # containers do not run as root.
  blobstore: /blobstore

  # The same trap, one release later and worse: since 2.34 the loader creates
  # storage.output.out_of_study.storage_dir while parsing the file, default
  # included, and the default is the relative ./outputs. Every process reading
  # this file dies with
  # `PermissionError: [Errno 13] Permission denied: 'outputs'` before it starts,
  # the schema migration included. Written absolute, onto a mount that exists.
  # This deployment leaves default_storage_type alone, so the directory itself
  # stays empty: outputs are written in the study tree.
  output:
    out_of_study:
      storage_dir: /outputs

  # -------------------------------------------------------------------------
  # Background maintenance tasks
  #
  # Read by the antarest-celery-beat and antarest-celery-worker containers, and
  # by nothing else: the API process starts no background service, since
  # `server.services` is left unset.
  #
  # The `*_dry_run` switches and the retention thresholds they go with are
  # written here. Every interval keeps its upstream default, see
  # docs/configuration.md for the `*_sleeping_time` and `*_cron` keys. Note
  # that auto_archive_sleeping_time and auto_archive_cron are mutually
  # exclusive: setting both makes the application refuse to start.
  #
  # watcher_scan_dry_run is written out too, although it holds the upstream
  # value, so that `grep dry_run config.prod.yaml` answers what this deployment
  # does rather than leaving half the answer implicit.
  #
  # tasks_gc_dry_run needs 2.34.0 or later to be read at all: the hand-written
  # config loader of 2.33 and earlier ignored that one key. See the defaults of
  # the role.
  # -------------------------------------------------------------------------
  matrix_gc_dry_run: {{ antarest_matrix_gc_dry_run | bool | lower }}
  blob_gc_dry_run: {{ antarest_blob_gc_dry_run | bool | lower }}
  variable_view_gc_dry_run: {{ antarest_variable_view_gc_dry_run | bool | lower }}
  tasks_gc_dry_run: {{ antarest_tasks_gc_dry_run | bool | lower }}
  auto_archive_dry_run: {{ antarest_auto_archive_dry_run | bool | lower }}
  # false: dry run here does not hold a deletion back, it stops the scan from
  # registering the studies it finds. See the defaults of the role.
  watcher_scan_dry_run: {{ antarest_watcher_scan_dry_run | bool | lower }}

  # How old a thing has to be before the tasks above take it. Seconds for the
  # matrix collector, days for the other three; the blob collector has no such
  # key upstream. See the defaults of the role.
  matrix_gc_retention_time: {{ antarest_matrix_gc_retention_time }}
  variable_view_gc_retention_days: {{ antarest_variable_view_gc_retention_days }}
  tasks_gc_retention_days: {{ antarest_tasks_gc_retention_days }}
  auto_archive_threshold_days: {{ antarest_auto_archive_threshold_days }}

  # Declared in the defaults of the role, where what an entry may carry is
  # written out. `default` is required and is the only one the watcher leaves
  # alone; in the others, a directory holding a file named AW_NO_SCAN is
  # skipped by the scan.
  #
  # The paths are the container side of the single /workspaces mount, so a
  # workspace is a directory under antarest_data_dir/workspaces on the host and
  # the role creates it.
  workspaces:
{% for _ws_name, _ws in antarest_workspaces.items() %}
{% set _ws = _ws or {} %}
    {{ _ws_name }}:
      path: /workspaces/{{ _ws.dir | default(_ws_name) }}/
{% if _ws.filter_in is defined %}
      filter_in: {{ _ws.filter_in | to_json }}
{% endif %}
{% if _ws.filter_out is defined %}
      filter_out: {{ _ws.filter_out | to_json }}
{% endif %}
{% if _ws.groups is defined %}
      groups: {{ _ws.groups | to_json }}
{% endif %}
{% endfor %}

# ---------------------------------------------------------------------------
# Launchers
#
# Since Antares-Web 2.20 the launchers are a list, each entry carrying its own
# `id`, `name` and `type`; `launcher.default` points at one of those ids.
# ---------------------------------------------------------------------------
launcher:
  default: {{ antarest_default_launcher }}
  launchers:

    - id: local
      name: Local solver
      type: local
      local_workspace: /local_workspace/local
      enable_nb_cores_detection: {{ antarest_local_launcher_nb_cores_detection | bool | lower }}
{% if not antarest_local_launcher_nb_cores_detection | bool %}
      nb_cores:
        min: {{ antarest_local_launcher_nb_cores.min }}
        default: {{ antarest_local_launcher_nb_cores.default }}
        max: {{ antarest_local_launcher_nb_cores.max }}
{% endif %}
      binaries:
{% for s in antares_solvers %}
        "{{ s.study_version }}": /antares_simulator/antares-{{ s.version }}-{{ antares_solver_os }}/bin/{{ s.bin }}
{% endfor %}
{% if slurm_enabled | bool %}

    - id: slurm
      name: Slurm cluster
      type: slurm
      local_workspace: /local_workspace/slurm
      username: {{ antares_user }}
      hostname: {{ slurm_frontend_ip | trim }}
      port: {{ slurm_launcher_ssh_port }}
      private_key_file: "/id_rsa"
      default_wait_time: {{ slurm_launcher_default_wait_time }}
      default_time_limit: {{ slurm_launcher_default_time_limit }}
      enable_nb_cores_detection: false
      nb_cores:
        min: {{ slurm_launcher_nb_cores_min }}
        default: {{ slurm_launcher_nb_cores_default }}
        max: {{ slurm_launcher_nb_cores_max }}
      default_json_db_name: launcher_db.json
      slurm_script_path: {{ slurm_launch_script }}
      partition: {{ slurm_partition }}
      antares_versions_on_remote_server:
{% for s in antares_solvers %}
        - "{{ s.study_version }}"
{% endfor %}
{% endif %}

debug: false

# See https://fastapi.tiangolo.com/advanced/behind-a-proxy/
# root_path is used when the API is served behind a proxy which adds a prefix
# for clients. It does NOT add any prefix to the URLs fastapi serves.
root_path: "api"

server:
  worker_threadpool_size: {{ antarest_worker_threadpool_size }}

logging:
  level: {{ antarest_log_level }}

# Redis is required when the application runs with several workers in a
# preforked model, which is what gunicorn does here. It is also, on database 1,
# the celery broker and result backend of the maintenance containers: the
# application derives those URLs from this section, so there is no `celery:`
# block to write.
redis:
  host: redis
  port: 6379
