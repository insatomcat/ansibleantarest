{{ ansible_managed | comment }}
#
# Layered on top of the project docker-compose.yml.
#
# The `!override` tags (Compose >= 2.24) replace the project's lists instead
# of concatenating with them, so the resulting mounts and published ports are
# exactly what is written here.
#
# What this override does:
#   - runs the antarest services as {{ antares_uid }}:{{ antares_gid }} so that the files they
#     create in the bind mounts belong to the antares user,
#   - moves every piece of persistent state out of the git checkout into
#     {{ antarest_data_dir }}, so that the checkout stays disposable,
#   - mounts the managed configuration, the solver directory and, when Slurm
#     is enabled, the private key used to reach the front-end.

services:

  antares-antarest:
    user: "{{ antares_uid }}:{{ antares_gid }}"
    volumes: !override
      - {{ antarest_data_dir }}/workspaces:/workspaces
      - {{ antarest_data_dir }}/tmp:/antarest_tmp_dir
      - {{ antarest_data_dir }}/matrices:/matrixstore
      - {{ antarest_data_dir }}/archives:/studies/archives
      - {{ antarest_data_dir }}/logs:/logs
      - {{ antarest_data_dir }}/local_workspace:/local_workspace
      - {{ antarest_deploy_dir }}/config.prod.yaml:/resources/application.yaml:ro
      - {{ antarest_dir }}/resources/deploy/gunicorn.py:/conf/gunicorn.py:ro
      - {{ antarest_solvers_dir }}:/antares_simulator:ro
{% if slurm_enabled | bool %}
      - {{ antarest_ssh_key }}:/id_rsa:ro
{% endif %}

  antares-antarest-watcher:
    user: "{{ antares_uid }}:{{ antares_gid }}"
    volumes: !override
      - {{ antarest_data_dir }}/workspaces:/workspaces
      - {{ antarest_data_dir }}/tmp:/antarest_tmp_dir
      - {{ antarest_data_dir }}/matrices:/matrixstore
      - {{ antarest_data_dir }}/archives:/studies/archives
      - {{ antarest_data_dir }}/logs:/logs
      - {{ antarest_deploy_dir }}/config.prod.yaml:/resources/application.yaml:ro

  antares-antarest-matrix-gc:
    user: "{{ antares_uid }}:{{ antares_gid }}"
    volumes: !override
      - {{ antarest_data_dir }}/workspaces:/workspaces
      - {{ antarest_data_dir }}/tmp:/antarest_tmp_dir
      - {{ antarest_data_dir }}/matrices:/matrixstore
      - {{ antarest_data_dir }}/archives:/studies/archives
      - {{ antarest_data_dir }}/logs:/logs
      - {{ antarest_deploy_dir }}/config.prod.yaml:/resources/application.yaml:ro

  postgresql:
    user: "{{ antares_uid }}:{{ antares_gid }}"
    environment:
      POSTGRES_PASSWORD: "{{ antarest_db_password }}"
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes: !override
      - {{ antarest_data_dir }}/db:/var/lib/postgresql/data

  nginx:
    ports: !override
      - "{{ antarest_http_port }}:80"
{% if antarest_enable_adminer | bool %}

  adminer:
    image: adminer
    container_name: antarest-adminer
    command: php -S 0.0.0.0:8080 -t /var/www/html
    depends_on:
      - postgresql
    ports:
      - "127.0.0.1:8080:8080"
{% endif %}
