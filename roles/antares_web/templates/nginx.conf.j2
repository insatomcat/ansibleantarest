{{ ansible_managed | comment }}
#
# Mounted as /etc/nginx/conf.d/default.conf in the {{ antarest_nginx_container }}
# container, in place of the resources/deploy/nginx.conf shipped by the project.
#
# It is that file plus one header: same client_max_body_size, same /www root
# with the SPA fallback, same /api/ proxy to http://antarest:5000/ with the
# websocket upgrade and the long read timeout. The checksum of the upstream
# file is compared to antarest_nginx_upstream_sha1 at deploy time, so a change
# on their side is reported instead of being silently ignored here.
#
# TLS is not here: the machine is fronted by the antares_edge container, which
# terminates it and proxies to the port this container publishes on the
# loopback.

# The scheme the *client* used, which this nginx cannot see: it is reached over
# plain http by the front door. Falls back to $scheme so that a request made
# directly to the loopback port - which is what the deployment's own health
# checks do - still carries something coherent.
map $http_x_forwarded_proto $antares_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen       80;
    server_name  _;

    client_max_body_size 1G;

    # serve static webapp files
    location / {
      root    /www;
      try_files $uri $uri/ /index.html = 404;
    }

    location /api/ {
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-Host $host:$server_port;
      proxy_set_header X-Forwarded-Server $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      # Not in the upstream file: it is what tells the backend it is reached
      # over https, so that anything it builds from the request scheme does not
      # point back at http. Honoured only because the antarest container gets
      # FORWARDED_ALLOW_IPS, gunicorn ignoring the header otherwise.
      proxy_set_header X-Forwarded-Proto $antares_forwarded_proto;
      proxy_redirect          off;
      proxy_pass      http://antarest:5000/;

      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_read_timeout 1200;
    }
}
