#!/bin/bash
#SBATCH --ntasks=1                       # Number of MPI ranks
#SBATCH --nodes=1                        # Number of nodes
#SBATCH --output=antares-out-%j.txt      # Standard output log
#SBATCH --error=antares-err-%j.txt       # Standard error log
#
{{ ansible_managed | comment }}
#
# Derived from
# https://github.com/AntaresSimulatorTeam/antares-launcher/blob/main/remote_scripts_templates/launchAntares_v1.1.2.sh
# with the site specific bits filled in:
#   - the solver and Xpansion tables below are generated from the
#     `antares_solvers` and `antares_xpansions` variables,
#   - the `module load` lines are dropped (no environment modules here); the
#     Xpansion branch runs the C++ implementation, which needs none, rather
#     than the R one the upstream template calls,
#   - the scratch directory lives in the shared /home so that the front-end
#     can collect the results.

INPUT_ZIPNAME=$1
ANTARES_VERSION=$2
JOB_TYPE=$3
POST_PROCESSING=$4
OTHER_OPTIONS=$5

# What kind of job is this?
# =========================
#
# antares-launcher sends the mode as the third argument, out of the four
# values of its `Modes` enum (see
# antareslauncher/remote_environnement/slurm_script_features.py). Every one of
# them is answered here, the unsupported ones included: running an ordinary
# simulation in their place is worse than refusing, because the study comes
# back green for an investment optimisation that never ran.
case "$JOB_TYPE" in
    ANTARES|"")
        RUN_MODE=antares
        ;;
    ANTARES_XPANSION_CPP)
        RUN_MODE=xpansion
        ;;
    ANTARES_XPANSION_R)
        echo "Xpansion in its R implementation is not supported on this cluster:" >&2
        echo "it needs R, the R libraries and XpansionArgsRun.R, none of which is" >&2
        echo "deployed here. Launch the study in the C++ mode instead." >&2
        exit 1
        ;;
    ANTARES_XPANSION_TRAJECTORY)
        echo "Xpansion trajectory mode, which runs several studies at once, is not" >&2
        echo "supported on this cluster." >&2
        exit 1
        ;;
    *)
        echo "Unknown job type '$JOB_TYPE'." >&2
        exit 1
        ;;
esac

# Set Variables
# =============
#
# antares-launcher passes the version as "major.minor" (e.g. "8.8"). Older
# releases passed the compact form ("880"), so both are accepted here.
if [ "$RUN_MODE" = "antares" ]; then
    case "$ANTARES_VERSION" in
{% for s in antares_solvers %}
        "{{ s.study_version }}"|"{{ s.study_version.split('.')[0] }}{{ s.study_version.split('.')[1] }}0"|"{{ s.version }}")
            export ANTARES_SOLVER_BIN="{{ slurm_solvers_dir }}/antares-{{ s.version }}-{{ antares_solver_os }}/bin/{{ s.bin }}"
            ;;
{% endfor %}
        *)
            echo "Unsupported Antares version '$ANTARES_VERSION' on this cluster." >&2
            echo "Available: {{ antares_solvers | map(attribute='study_version') | join(', ') }}" >&2
            exit 1
            ;;
    esac

    if [ ! -x "$ANTARES_SOLVER_BIN" ]; then
        echo "Solver binary $ANTARES_SOLVER_BIN is missing or not executable." >&2
        exit 1
    fi
else
{% if antares_xpansion_enabled | bool %}
    # An Xpansion release ships the antares-solver it was built against and
    # runs the study with that one, so the version is matched against the
    # package table rather than against the solvers installed next to it.
    case "$ANTARES_VERSION" in
{% for x in antares_xpansions %}
{% set x_dir = (x.archive | default('antaresXpansion-' ~ x.version ~ '-' ~ (antares_xpansion_os | trim) ~ '.tar.gz')) | regex_replace('\.tar\.gz$', '') %}
        "{{ x.study_version }}"|"{{ x.study_version.split('.')[0] }}{{ x.study_version.split('.')[1] }}0")
            export XPANSION_LAUNCHER_BIN="{{ slurm_xpansion_dir }}/{{ x_dir }}/antares-xpansion-launcher"
            ;;
{% endfor %}
        *)
            echo "No Antares-Xpansion package for study version '$ANTARES_VERSION' on this cluster." >&2
            echo "Available: {{ antares_xpansions | map(attribute='study_version') | join(', ') }}" >&2
            exit 1
            ;;
    esac

    if [ ! -x "$XPANSION_LAUNCHER_BIN" ]; then
        echo "Xpansion launcher $XPANSION_LAUNCHER_BIN is missing or not executable." >&2
        exit 1
    fi

{% if antares_xpansion_mpi_bin_dir | trim | length > 0 %}
    # EL keeps its Open MPI out of the default paths.
    export PATH="{{ antares_xpansion_mpi_bin_dir | trim }}:$PATH"
{% endif %}
{% if antares_xpansion_mpi_lib_dir | trim | length > 0 %}
    export LD_LIBRARY_PATH="{{ antares_xpansion_mpi_lib_dir | trim }}${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
{% endif %}
{% else %}
    echo "Antares-Xpansion is not deployed on this cluster." >&2
    echo "Set antares_xpansion_enabled to true and re-run the playbook." >&2
    exit 1
{% endif %}
fi

# Set OMP_NUM_THREADS for the parallel parts
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}

# Set local variables
USER_HOME=$PWD
JOB_SCRATCH_DIR={{ slurm_scratch_dir }}/antares_${SLURM_JOB_ID}
STUDY_NAME=$SLURM_JOB_NAME
STUDY_PATH=$JOB_SCRATCH_DIR/$STUDY_NAME
SLURM_LOG_FILE=$USER_HOME/${STUDY_NAME}_job_data_${SLURM_JOB_ID}.txt
DATE_FORMAT="%Y-%m-%d-%H:%M"
START_TIME=$(date +$DATE_FORMAT)
POST_PROCESSING_SCRIPT_NAME="post-processing.R"

case "$JOB_TYPE" in
  ANTARES_XPANSION*)
    STAT_FILE=$USER_HOME/stats-xpansion-v1.1.txt
    FINAL_ZIP_FILE=finished_XPANSION_${STUDY_NAME}_${SLURM_JOB_ID}.zip
    ;;
  *)
    STAT_FILE=$USER_HOME/stats-antares-v1.1.txt
    FINAL_ZIP_FILE=finished_${STUDY_NAME}_${SLURM_JOB_ID}.zip
    ;;
esac

function print_message {
 echo "$1" >> "$SLURM_LOG_FILE"
}

function print_timed_message {
  local MY_TIME
  MY_TIME=$(date +$DATE_FORMAT)
  print_message "$MY_TIME >>> $1"
}

print_timed_message "START"
print_message "JOB_TYPE = $JOB_TYPE"
print_message "INPUT_ZIPNAME as from stdin  = $1"
print_message "antares_version from stdin  = $ANTARES_VERSION"
print_message "run mode: $RUN_MODE"
print_message "binary: ${ANTARES_SOLVER_BIN:-$XPANSION_LAUNCHER_BIN}"
print_message "name of the study: $STUDY_NAME"
print_message "zipfile: $INPUT_ZIPNAME"
print_message "home directory: $USER_HOME"
print_message "hostname: $SLURM_JOB_NODELIST"
print_message "local directory: $JOB_SCRATCH_DIR"
print_message " "

# create job-specific temporary scratch directory
mkdir -p "$JOB_SCRATCH_DIR"
# copy input_zipfile to JOB_SCRATCH_DIR
cp "$INPUT_ZIPNAME" "$JOB_SCRATCH_DIR"
# change pwd to JOB_SCRATCH_DIR
cd "$JOB_SCRATCH_DIR" || exit

# Unzip input zipfile
SECONDS=0
print_timed_message "start UNZIP"
srun unzip "$INPUT_ZIPNAME" > /dev/null 2>&1
rm "$INPUT_ZIPNAME"
print_timed_message "end UNZIP"
UNZIP_DURATION=$SECONDS
print_message "unzip duration = $UNZIP_DURATION"
print_message " "

# Launch ANTARES or ANTARES_XPANSION
SECONDS=0
print_timed_message "start $JOB_TYPE"
if [ "$RUN_MODE" = "xpansion" ]; then
  # Deliberately not under srun, unlike every other step here. The launcher
  # drives the whole chain itself - the bundled antares-solver on the weekly
  # problems, lp_namer, then Benders, which is an MPI binary - and an MPI
  # program started inside an srun step is a "direct launch" as far as Open
  # MPI is concerned: it then demands Slurm's PMI/PMIx support and aborts in
  # MPI_Init without it ("OPAL ERROR: Unreachable in ext3x_client.c"). Run
  # from the batch step it initialises on its own.
  #
  # Same reason the number of ranks goes to the launcher rather than to srun.
  # Above 1 it spawns them through mpirun, which inside an allocation goes
  # back through Slurm and needs that PMIx support after all, so raising
  # slurm_xpansion_mpi_procs means installing it on the nodes.
  # shellcheck disable=SC2086
  "$XPANSION_LAUNCHER_BIN" --step full -i "$STUDY_PATH" \
       --antares-n-cpu "${SLURM_CPUS_PER_TASK:-1}" \
       -n {{ slurm_xpansion_mpi_procs }} $OTHER_OPTIONS
else
  # shellcheck disable=SC2086
  srun $ANTARES_SOLVER_BIN --force-parallel=${SLURM_CPUS_PER_TASK:-1} -i "$STUDY_PATH" $OTHER_OPTIONS
fi
RUN_RC=$?
print_timed_message "end $JOB_TYPE"
print_message "$JOB_TYPE exit code = $RUN_RC"
ANTARES_DURATION=$SECONDS
print_message "$JOB_TYPE duration = $ANTARES_DURATION"
print_message " "

# Launch post processing
POST_PROC_DURATION=0
if [ "$POST_PROCESSING" = "True" ]; then
  SECONDS=0
  print_timed_message "start POST-PROCESSING"
  cd "$STUDY_PATH" || exit

  srun Rscript $POST_PROCESSING_SCRIPT_NAME
  print_timed_message "end POST-PROCESSING"
  POST_PROC_DURATION=$SECONDS
  print_message "post processing duration = $POST_PROC_DURATION"
  print_message " "
  cd "$JOB_SCRATCH_DIR" || exit
fi

# Zip finished study
SECONDS=0
print_timed_message "start ZIP"
srun zip -2 -r "${USER_HOME}"/"$FINAL_ZIP_FILE" "$STUDY_NAME" > /dev/null 2>&1
print_timed_message "finish ZIP"
ZIP_DURATION=$SECONDS
print_message "final zip duration = $ZIP_DURATION"
print_message " "

# Print SLURM environment to file
SLURM_ENV=$(env | grep SLURM)
print_message "$SLURM_ENV"
print_message " "

# remove scratch folder
srun rm -rf "${JOB_SCRATCH_DIR}"

# Output job stat to file
if [[ ! -f "$STAT_FILE" ]]; then
    echo "START-TIME SLURM_JOB_NAME SLURM_JOB_ID SLURM_CPUS_PER_TASK UNZIP_DURATION ANTARES_DURATION POST_PROC_DURATION ZIP_DURATION" > "${STAT_FILE}"
fi
echo "$START_TIME $SLURM_JOB_NAME $SLURM_JOB_ID $SLURM_CPUS_PER_TASK $UNZIP_DURATION $ANTARES_DURATION $POST_PROC_DURATION $ZIP_DURATION" >> "${STAT_FILE}"

# Goodbye
print_timed_message "THE END"

# Exit on the code of the run, not on that of the last command of the script -
# which is what the upstream template does, and the reason a solver killed by
# the OOM killer still produced a job Slurm recorded as COMPLETED and a study
# Antares-Web showed as successful. Everything above this line still runs when
# the solver fails: the zip is built and the scratch is cleaned, so the partial
# results and the logs come back. That is what makes this safe, and it is not
# an assumption about the launcher: a job in FAILED state gives
# `finished_with_error` in antares-launcher, which still downloads the final
# zip, and Antares-Web's `_handle_failure` still imports whatever output it
# finds before marking the job failed.
exit $RUN_RC
