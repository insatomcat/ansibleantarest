{{ ansible_managed | comment }}
# MariaDB backing the Slurm accounting database (slurmdbd).
#
# The port is published on the loopback only: slurmdbd runs on this very host
# and there is no reason to expose the database root account to the network.

services:

  db:
    image: {{ slurmdbd_mariadb_image }}
    container_name: slurmdb-mariadb
    restart: always
    environment:
      MARIADB_ROOT_PASSWORD: "{{ slurmdbd_db_password }}"
      MARIADB_DATABASE: "slurm_acct_db"
    ports:
      - "127.0.0.1:3306:3306"
    volumes:
      - slurmdb_data:/var/lib/mysql
    command: >
      --innodb-buffer-pool-size={{ slurmdbd_innodb_buffer_pool_size }}
      --innodb-lock-wait-timeout=900
      --innodb-flush-log-at-trx-commit=2
      --max-connections=4096
{% if slurmdbd_enable_adminer | bool %}

  adminer:
    image: adminer
    container_name: slurmdb-adminer
    restart: always
    command: php -S 0.0.0.0:8080 -t /var/www/html
    ports:
      - "127.0.0.1:8080:8080"
{% endif %}

volumes:
  slurmdb_data:
