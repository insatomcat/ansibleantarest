{{ ansible_managed | comment }}
#
# Single handle on the accounting database containers, the way the compose
# wrapper unit used to be:
#
#   systemctl start   slurmdb.target
#   systemctl restart slurmdb.target
#
# The containers declare PartOf= on it, which is what propagates a stop or a
# restart. It also gives something enableable: the container services are
# generated by quadlet, and systemctl enable refuses to touch generated units.

[Unit]
Description=Slurm accounting database
After=network-online.target
Wants=network-online.target

[Install]
WantedBy=multi-user.target
