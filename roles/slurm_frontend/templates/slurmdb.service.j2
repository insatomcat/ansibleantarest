{{ ansible_managed | comment }}
[Unit]
Description=Slurm accounting database (MariaDB)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
TimeoutStartSec=0
WorkingDirectory={{ slurmdbd_dir }}
ExecStart={{ docker_compose_cmd }} -f {{ slurmdbd_dir }}/docker-compose.yml up -d --remove-orphans
ExecStop={{ docker_compose_cmd }} -f {{ slurmdbd_dir }}/docker-compose.yml down
ExecReload={{ docker_compose_cmd }} -f {{ slurmdbd_dir }}/docker-compose.yml restart

[Install]
WantedBy=multi-user.target
