    {
      "type": "text",
      "title": "",
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "options": {
        "mode": "markdown",
        "content": "Share of the probes that succeeded over the period chosen above. **These figures cannot see the machine being down**: Prometheus goes down with it and counts nothing while it is. The reference figure for the monthly report is the external probe, in OCI Health Checks, which polls the front door from outside."
      }
    },
    {
      "type": "stat",
      "title": "Front door",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "antares-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "antares-prometheus"
          },
          "expr": "avg_over_time(probe_success{service=\"front-door\"}[$__range]) * 100",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
