{
  "title": "Antares node",
  "uid": "antares-node",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": [
    "antares"
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "instance",
        "label": "Machine",
        "datasource": {
          "type": "prometheus",
          "uid": "antares-prometheus"
        },
        "definition": "label_values(node_uname_info, instance)",
        "query": {
          "query": "label_values(node_uname_info, instance)",
          "refId": "instance"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Uptime",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "antares-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "antares-prometheus"
          },
          "expr": "time() - node_boot_time_seconds{instance=\"$instance\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
