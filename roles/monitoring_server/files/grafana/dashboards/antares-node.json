      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "antares-prometheus"
          },
          "expr": "max(100 - 100 * node_filesystem_avail_bytes{instance=\"$instance\",fstype!~\"tmpfs|ramfs|vfat|overlay|squashfs\"} / node_filesystem_size_bytes{instance=\"$instance\",fstype!~\"tmpfs|ramfs|vfat|overlay|squashfs\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
