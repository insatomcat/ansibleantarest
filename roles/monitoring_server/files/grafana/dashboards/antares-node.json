      }
    },
    {
      "type": "stat",
      "title": "Load 5 min, per CPU",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "antares-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "antares-prometheus"
          },
          "expr": "node_load5{instance=\"$instance\"} / scalar(count(node_cpu_seconds_total{instance=\"$instance\",mode=\"idle\"}))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
