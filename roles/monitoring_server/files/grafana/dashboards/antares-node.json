        "textMode": "auto"
      },
      "description": "Zero with no swap configured, which is how the cloud images ship."
    },
    {
      "type": "stat",
      "title": "Fullest filesystem",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "antares-prometheus"
