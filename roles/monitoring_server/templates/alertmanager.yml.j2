{{ ansible_managed | comment }}
#
# Mounted read-only as /etc/alertmanager/alertmanager.yml in the
# {{ monitoring_alertmanager_container }} container. Holds the SMTP password,
# hence 0600.

{% if monitoring_alert_email_to | length > 0 %}
global:
  smtp_smarthost: {{ monitoring_alert_smtp_smarthost | to_json }}
  smtp_from: {{ monitoring_alert_email_from | to_json }}
  smtp_auth_username: {{ monitoring_alert_smtp_username | to_json }}
  smtp_auth_password: {{ monitoring_alert_smtp_password | to_json }}
  smtp_require_tls: true
{% endif %}

route:
  receiver: {{ 'email' if monitoring_alert_email_to | length > 0 else 'nowhere' }}
  # One message per alert name and machine: a disk filling up and a service
  # down are two mails, the same disk on two runs of the rules is one.
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: {{ monitoring_alert_repeat_interval }}

# A machine that is down raises every alert of the things on it: the one
# that says so is enough.
inhibit_rules:
  - source_matchers: [alertname = "MachineDown"]
    target_matchers: [alertname != "MachineDown"]
    equal: [instance]

receivers:
  - name: nowhere
{% if monitoring_alert_email_to | length > 0 %}
  - name: email
    email_configs:
{% for to in monitoring_alert_email_to %}
      - to: {{ to | to_json }}
        send_resolved: true
        headers:
          Subject: '[{{ antarest_tls_domain | default(inventory_hostname, true) }}] {{ "{{" }} .Status | toUpper {{ "}}" }}: {{ "{{" }} .CommonLabels.alertname {{ "}}" }} {{ "{{" }} .CommonLabels.instance {{ "}}" }}'
{% endfor %}
{% endif %}
