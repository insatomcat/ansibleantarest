{{ ansible_managed | comment }}
#
# Build context: roles/antares_auth/files/{{ antares_auth_source }}, copied here
# by the role. The base image is written fully qualified for the same reason as
# everywhere else in this deployment - podman will not guess a registry, and
# the RHEL rebuilds would guess a different one.

FROM {{ antares_auth_python_image }}

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

EXPOSE {{ antares_auth_port }}

# gunicorn rather than the Flask development server: this sits in front of
# every login of the deployment, and the development server is single-threaded,
# unsupervised and says so on every start. Access logs to stdout, which the
# journald log driver of the unit collects.
#
# --no-control-socket: gunicorn 25 added a unix socket for its control
# interface, the one `gunicornc` drives, and turns it on by default. Its path
# is $XDG_RUNTIME_DIR/gunicorn.ctl, and that variable is unset in a container,
# so it falls back to $HOME/.gunicorn - which here is /app, the WORKDIR, owned
# by root while the process runs as the antares account:
#
#   [ERROR] Control server error: [Errno 13] Permission denied: '/app/.gunicorn'
#
# at every single start. Harmless, gunicorn carries on and serves, but an ERROR
# in the journal of the path every login goes through is a false lead nobody
# needs. Turned off rather than given a writable directory it would be used
# from by nothing.
CMD ["gunicorn", \
     "--bind", "0.0.0.0:{{ antares_auth_port }}", \
     "--workers", "{{ antares_auth_workers }}", \
     "--access-logfile", "-", \
     "--no-control-socket", \
     "app:app"]
