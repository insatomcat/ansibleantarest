{{ ansible_managed | comment }}
LOG_LEVEL={{ antares_auth_log_level }}
KEYCLOAK_URL={{ antares_auth_keycloak_url | trim }}
KEYCLOAK_REALM={{ keycloak_realm }}
KEYCLOAK_CLIENT_ID={{ keycloak_client_id }}
KEYCLOAK_CLIENT_SECRET={{ keycloak_client_secret }}
KEYCLOAK_GROUP_KEY={{ antares_auth_keycloak_group_key }}
ANTAREST_URL=http://antarest:5000
ANTAREST_ADMIN_USER=admin
ANTAREST_ADMIN_PASSWORD={{ antarest_admin_password }}
PGHOST=postgresql
PGPORT=5432
PGDATABASE=postgres
PGUSER={{ antares_auth_sync_db_user }}
PGPASSWORD={{ antares_auth_sync_db_password }}
SYNC_GROUP_MAPPING={{ antarest_external_auth_group_mapping | to_json }}
SYNC_ADD_EXT_GROUPS={{ antarest_external_auth_add_ext_groups | bool | lower }}
SYNC_DEFAULT_ROLE={{ antarest_external_auth_default_group_role }}
SYNC_ROLES={{ antares_auth_sync_roles | to_json }}
SYNC_MAX_CLOSURES={{ antares_auth_sync_max_closures }}
SYNC_DRY_RUN={{ antares_auth_sync_dry_run | bool | lower }}
