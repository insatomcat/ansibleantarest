{{ ansible_managed | comment }}
#
# Mounted as /etc/nginx/conf.d/default.conf in the {{ antares_edge_container }}
# container, which runs in the host network namespace: what is written
# `listen {{ antarest_http_port }}` below is the port of the machine itself.
#
# Every upstream is an address and a port, never a name. nginx resolves the
# upstream of a proxy_pass once, when the configuration is parsed, and refuses
# to start when a name does not resolve; with addresses there is nothing to
# resolve, so this front end starts and keeps serving whatever is up, and
# answers 502 for whatever is not. That is the whole reason it exists next to
# the Antares-Web nginx rather than in it.

# `upgrade` for a request that asks for it, `close` otherwise. The Antares-Web
# API carries websockets, and hardcoding `Connection: upgrade` for every
# request - which the file the project ships does - breaks keepalive for the
# rest.
map $http_upgrade $antares_edge_connection {
    default upgrade;
    ''      close;
}
{% if antares_edge_basic_auth_tiers %}

# ---------------------------------------------------------------------------
#  The password in front of the password
#
#  auth_basic takes a realm, and the string `off` in its place switches it off.
#  Both are computed per request here rather than written into the locations,
#  which is what lets one location be closed to the internet and open to the
#  machine itself.
# ---------------------------------------------------------------------------
{% for tier in antares_edge_basic_auth_tiers %}

# The realm the {{ tier.name }} tier announces, and `off` for the addresses the
# front door never challenges. `geo` rather than `map`, for the CIDR notation.
geo $antares_edge_{{ tier.name }}_realm {
    default "{{ tier.realm }}";
{% for network in antares_edge_basic_auth_trusted %}
    {{ network }} off;
{% endfor %}
}

# The same realm, for the one prefix of that tier whose clients bring a
# credential of their own. Every interface here authenticates its own API
# calls with a bearer token, in the Authorization header - the very header
# basic authentication uses. A browser cannot send both, so a password asked
# on those calls does not make the deployment more private, it makes the
# interface unusable: that is the Antares-Web login form answering `Bad
# Authorization header` and the Keycloak console never loading a realm.
#
# A request that qualifies is not let in, it is handed to the service behind,
# which asks it for the token it claims to have. Same for a websocket
# handshake, which a browser cannot put a header on at all. See the README of
# this role for what that exemption does and does not leave exposed.
map "$http_upgrade:$http_authorization" $antares_edge_{{ tier.name }}_token_realm {
    default          $antares_edge_{{ tier.name }}_realm;
    "~*^websocket:"  off;
    "~*^:bearer "    off;
}
{% endfor %}

# What the service behind sees in the Authorization header. The basic
# credential this door has just checked is the door's own business and has to
# stop here: forwarded, Antares-Web reads it as a malformed bearer token and
# refuses to log anybody in, and Grafana reads it as one of its own accounts
# and challenges for a password of its own, which is a browser prompt that
# never ends. An empty value is not sent at all, which is exactly right - the
# request reaches the service as if there had been no door. Anything that is
# not Basic is the caller's own credential and is passed through untouched.
map $http_authorization $antares_edge_upstream_auth {
    default      $http_authorization;
    "~*^Basic "  "";
}
{% endif %}

{% macro proxy_headers() %}
      proxy_set_header Host              $host;
      proxy_set_header X-Real-IP         $remote_addr;
      proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Host  $host;
      proxy_set_header X-Forwarded-Port  $server_port;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header Upgrade           $http_upgrade;
      proxy_set_header Connection        $antares_edge_connection;
{%- endmacro %}
{% macro routes() %}
    client_max_body_size {{ antares_edge_client_max_body_size }};
    proxy_http_version 1.1;
    proxy_redirect     off;
    proxy_read_timeout {{ antares_edge_proxy_read_timeout }};

    # The headers of proxy_headers() go into every location rather than once
    # on the server. nginx hands a location the proxy_set_header of the server
    # only when it declares none of its own, and a gated one declares
    # Authorization: set on the server, all of them silently vanished behind
    # the password, and Grafana, told Host 127.0.0.1, refused every dashboard
    # query as a cross-origin POST.
    #
    # Host is what the services behind build their own URLs from, so it has
    # to stay the name the user typed rather than become the loopback address
    # nginx proxies to (which is what $proxy_host, the default, would give).
    # X-Forwarded-Proto is the whole point of terminating TLS here: it is what
    # tells them the client is on https, so that nothing they build points
    # back at http.
{% for route in antares_edge_routes %}
{% set tier = route.auth | default('') %}
{% set gated = tier in antares_edge_basic_auth_names %}
{% if gated and route.token_path is defined %}

    # {{ route.name }}, the part of it whose clients authenticate themselves.
    # Longer prefix than the location below, so it wins whatever the order.
    location {{ route.token_path }} {
      auth_basic           $antares_edge_{{ tier }}_token_realm;
      auth_basic_user_file {{ antares_edge_htpasswd_container_dir }}/{{ tier }};
      proxy_set_header     Authorization $antares_edge_upstream_auth;
{{ proxy_headers() }}
      proxy_pass http://{{ route.upstream }};
    }
{% endif %}

    location {{ route.path }} {   # {{ route.name }}
{% if gated %}
      auth_basic           $antares_edge_{{ tier }}_realm;
      auth_basic_user_file {{ antares_edge_htpasswd_container_dir }}/{{ tier }};
      proxy_set_header     Authorization $antares_edge_upstream_auth;
{% endif %}
{{ proxy_headers() }}
      proxy_pass http://{{ route.upstream }};
    }
{% endfor %}
{% endmacro %}
{% macro acme_challenge() %}
{% if antarest_tls_enabled | bool and antarest_tls_provider == 'letsencrypt' %}
    # Left served over plain http on purpose: this is the only path certbot
    # needs, and the ACME server follows redirects but has nothing to validate
    # a certificate against on a host that does not have one yet.
    location ^~ /.well-known/acme-challenge/ {
      root {{ antarest_tls_webroot_container }};
      default_type "text/plain";
    }
{% endif %}
{% endmacro %}
server {
    listen       {{ antarest_http_port }};
    server_name  {{ antarest_tls_domain | default('', true) | trim or '_' }};
{{ acme_challenge() }}
{% if antarest_tls_active | bool and antarest_tls_redirect_http | bool %}

    location / {
      return 301 https://$host$request_uri;
    }
{% else %}
{{ routes() }}
{% endif %}
}
{% if antarest_tls_active | bool %}

server {
    listen       {{ antarest_https_port }} ssl;
    http2        on;
    server_name  {{ antarest_tls_domain }};

    ssl_certificate     {{ antarest_tls_cert }};
    ssl_certificate_key {{ antarest_tls_key }};

    # Mozilla "intermediate" without the TLS 1.2 ciphers that need an explicit
    # list: everything below TLS 1.2 is off, and the 1.3 suites are picked by
    # OpenSSL itself.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
{% if antarest_tls_hsts_max_age | int > 0 %}

    # Tells the browser never to come back over http. Deliberately without
    # includeSubDomains and preload: this host is usually one name among others
    # on the domain, and the header is hard to take back once it is cached.
    add_header Strict-Transport-Security "max-age={{ antarest_tls_hsts_max_age }}" always;
{% endif %}
{{ routes() }}
}
{% endif %}
