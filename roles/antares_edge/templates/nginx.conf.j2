{{ ansible_managed | comment }}
#
# Mounted as /etc/nginx/conf.d/default.conf in the {{ antares_edge_container }}
# container, which runs in the host network namespace: what is written
# `listen {{ antarest_http_port }}` below is the port of the machine itself.
#
# Every upstream is an address and a port, never a name. nginx resolves the
# upstream of a proxy_pass once, when the configuration is parsed, and refuses
# to start when a name does not resolve; with addresses there is nothing to
# resolve, so this front end starts and keeps serving whatever is up, and
# answers 502 for whatever is not. That is the whole reason it exists next to
# the Antares-Web nginx rather than in it.

# `upgrade` for a request that asks for it, `close` otherwise. The Antares-Web
# API carries websockets, and hardcoding `Connection: upgrade` for every
# request - which the file the project ships does - breaks keepalive for the
# rest.
map $http_upgrade $antares_edge_connection {
    default upgrade;
    ''      close;
}

{% macro routes() %}
    client_max_body_size {{ antares_edge_client_max_body_size }};

    # Set on the server rather than in each location, which inherits them as
    # long as it declares none of its own. Host is what the services behind
    # build their own URLs from, so it has to stay the name the user typed
    # rather than become the loopback address nginx proxies to (which is what
    # $proxy_host, the default, would give). X-Forwarded-Proto is the whole
    # point of terminating TLS here: it is what tells them the client is on
    # https, so that nothing they build points back at http.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $antares_edge_connection;
    proxy_http_version 1.1;
    proxy_redirect     off;
    proxy_read_timeout {{ antares_edge_proxy_read_timeout }};
{% for route in antares_edge_routes %}

    location {{ route.path }} {   # {{ route.name }}
      proxy_pass http://{{ route.upstream }};
    }
{% endfor %}
{% endmacro %}
{% macro acme_challenge() %}
{% if antarest_tls_enabled | bool and antarest_tls_provider == 'letsencrypt' %}
    # Left served over plain http on purpose: this is the only path certbot
    # needs, and the ACME server follows redirects but has nothing to validate
    # a certificate against on a host that does not have one yet.
    location ^~ /.well-known/acme-challenge/ {
      root {{ antarest_tls_webroot_container }};
      default_type "text/plain";
    }
{% endif %}
{% endmacro %}
server {
    listen       {{ antarest_http_port }};
    server_name  {{ antarest_tls_domain | default('', true) | trim or '_' }};
{{ acme_challenge() }}
{% if antarest_tls_active | bool and antarest_tls_redirect_http | bool %}

    location / {
      return 301 https://$host$request_uri;
    }
{% else %}
{{ routes() }}
{% endif %}
}
{% if antarest_tls_active | bool %}

server {
    listen       {{ antarest_https_port }} ssl;
    http2        on;
    server_name  {{ antarest_tls_domain }};

    ssl_certificate     {{ antarest_tls_cert }};
    ssl_certificate_key {{ antarest_tls_key }};

    # Mozilla "intermediate" without the TLS 1.2 ciphers that need an explicit
    # list: everything below TLS 1.2 is off, and the 1.3 suites are picked by
    # OpenSSL itself.
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
{% if antarest_tls_hsts_max_age | int > 0 %}

    # Tells the browser never to come back over http. Deliberately without
    # includeSubDomains and preload: this host is usually one name among others
    # on the domain, and the header is hard to take back once it is cached.
    add_header Strict-Transport-Security "max-age={{ antarest_tls_hsts_max_age }}" always;
{% endif %}
{{ routes() }}
}
{% endif %}
