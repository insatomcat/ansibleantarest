{{ ansible_managed | comment }}
#
# The {{ item.name }} tier of the front door, read by nginx as
# auth_basic_user_file {{ antares_edge_htpasswd_container_dir }}/{{ item.name }}.
# One `login:hash` per line, straight from
# antares_edge_basic_auth{{ '_admin' if item.name == 'admin' else '' }}_users{{ ', then antares_edge_basic_auth_admin_users (antares_edge_basic_auth_admin_opens_app)' if item.name == 'app' and antares_edge_basic_auth_admin_opens_app | bool and antares_edge_basic_auth_admin_users | length > 0 else '' }}.
{% for user in item.users %}
{{ user.name }}:{{ user.hash }}
{% endfor %}
