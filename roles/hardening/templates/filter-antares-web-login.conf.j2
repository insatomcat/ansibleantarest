{{ ansible_managed | comment }}
#
# Failed logins on the Antares-Web API, read from the nginx access log as it
# reaches the journal:
#
#   203.0.113.7 - - [14/Aug/2026:09:12:33 +0000] "POST {{ hardening_fail2ban_web_login_path }} HTTP/1.1" 401 42 "-" "curl/8.5.0"
#
# The address is the real one: this log comes from the front door, which runs
# in the host network namespace and is therefore reached directly, with nothing
# in front to rewrite the source. Read from the Antares-Web nginx instead, every
# client would look like the front door and one bad password would ban
# everybody.
#
# No datepattern: the systemd backend takes the time from the journal entry.

[Definition]

failregex = ^<HOST> \S+ \S+ \[[^\]]*\] "POST {{ hardening_fail2ban_web_login_path }} HTTP/[^"]*" 401\b

ignoreregex =
